# ── Copy this file to .env and fill in your values ──────────
# NEVER commit .env to git

# Flask
FLASHCUT_SECRET=change-this-to-a-long-random-string
FLASK_ENV=development

# Admin credentials (set these in Render dashboard too)
ADMIN_USER=flashcut123
ADMIN_PASS=43214321

# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
# Use SERVICE_ROLE key — gives full DB access, bypasses RLS
# NEVER expose this in frontend JS — backend only!
SUPABASE_KEY=your_service_role_key_here

# ── ImageKit ─────────────────────────────────────────────────
# Get all three from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=your_private_key_here
IMAGEKIT_PUBLIC_KEY=your_public_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Folder inside ImageKit where uploads are stored
IMAGEKIT_FOLDER=flashcut
